{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offgrid-equipment-scraper",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workflows": [
    { "name": "seller-crawl", "binding": "SELLER_CRAWL", "class_name": "SellerCrawl" },
    { "name": "classify-sightings", "binding": "CLASSIFY_SIGHTINGS", "class_name": "ClassifySightings" },
    { "name": "page-crawl", "binding": "PAGE_CRAWL", "class_name": "PageCrawl" },
    { "name": "manufacturer-crawl", "binding": "MANUFACTURER_CRAWL", "class_name": "ManufacturerCrawl" },
    { "name": "document-convert", "binding": "DOCUMENT_CONVERT", "class_name": "DocumentConvert" },
    { "name": "extract-specs", "binding": "EXTRACT_SPECS", "class_name": "ExtractSpecs" }
  ],
  "ai": { "binding": "AI", "remote": true },
  "r2_buckets": [
    { "binding": "ARCHIVE", "bucket_name": "offgrid-equipment-archive" }
  ],
  "triggers": { "crons": ["0 6 * * 1"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
