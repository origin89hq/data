{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2022"
    ],
    "types": [
      "./worker-configuration.d.ts",
      "./secrets.d.ts"
    ],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "worker-configuration.d.ts",
    "secrets.d.ts",
    "../schema/*.ts"
  ]
}
