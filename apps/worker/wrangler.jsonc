{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offgrid-equipment-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  // The public face of the dataset. A logo has to render in a browser, so it cannot carry a token,
  // and a custom domain on our own zone is what lets a page cache and reference it. Everything but
  // `logos/<maker>-<width>.png` still needs the bearer, whichever host asks.
  "routes": [{ "pattern": "data.origin89.com", "custom_domain": true }],
  // The brand palette and the Plate 89 mark are imported as text from @origin89/brand rather than
  // copied into the page. A copy is a palette that drifts from the one every other Origin89 surface
  // uses, and nothing would say when it had.
  // The site is a built React app. The Worker sees every request first, answers the ones that are
  // its own — a table, a mark, anything behind the token — and hands the rest to the asset store.
  // Assets first would have taken "/" before the Worker could tell a browser from a client.
  "assets": { "directory": "../site/dist", "binding": "SITE", "run_worker_first": true },
  // PDFium arrives as WebAssembly, compiled at upload: a Worker cannot compile it while it runs.
  // Named here so `wrangler types` declares the import, as it does the stylesheet.
  "rules": [
    { "type": "Text", "globs": ["**/*.css", "**/*.svg"], "fallthrough": true },
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }
  ],
  // Workflows are for a sequence with a wait in it. Crawling a shop is ordered pagination, and
  // the maker pipeline pauses for a person; everything that merely fans out is on the queue.
  "workflows": [
    { "name": "seller-crawl", "binding": "SELLER_CRAWL", "class_name": "SellerCrawl" },
    { "name": "page-crawl", "binding": "PAGE_CRAWL", "class_name": "PageCrawl" },
    {
      "name": "manufacturer-crawl",
      "binding": "MANUFACTURER_CRAWL",
      "class_name": "ManufacturerCrawl"
    }
  ],
  "queues": {
    "producers": [{ "queue": "offgrid-work", "binding": "WORK" }],
    "consumers": [
      {
        "queue": "offgrid-work",
        // Small batches on purpose. A message can be a PDF to convert, and the parallelism
        // worth having is the twenty consumers below, not ten heavy jobs sharing one isolate.
        "max_batch_size": 3,
        "max_batch_timeout": 5,
        "max_concurrency": 20,
        "max_retries": 3,
        "dead_letter_queue": "offgrid-work-dead"
      }
    ]
  },
  "ai": { "binding": "AI", "remote": true },
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "offgrid-equipment-archive" }],
  "triggers": { "crons": ["0 6 * * 1", "0 7 1 * *", "0 8 * * *"] },
  // A token the Worker has not seen costs calls to GitHub on the app's own credentials, and
  // somebody sending made-up tokens would spend the app's allowance and lock members out. So those
  // calls are rationed per address. The namespace is this Worker's own.
  //
  // The page reader's pace. Kimi K2.7 serves an account 20 requests a minute on standard billing,
  // and a page is up to two of them, so nine pages a minute stays under it. Twenty consumers each
  // calling as fast as they could lost 1,996 of 2,148 pages to the limit (#29).
  "ratelimits": [
    { "name": "SIGN_IN_CHECKS", "namespace_id": "89001", "simple": { "limit": 30, "period": 60 } },
    { "name": "PAGE_READER_PACE", "namespace_id": "89002", "simple": { "limit": 9, "period": 60 } }
  ],
  // The origin89hq GitHub App people sign in through. A client id is not a secret: it is in every
  // sign-in URL. Its client secret is, and is the one below.
  "vars": { "GITHUB_CLIENT_ID": "Iv23liFkUtlIH9Q8Xc1h" },
  // Named here rather than in a hand-written type: wrangler generates the binding types from
  // this, warns in local development when one is missing, and there is one place that says the
  // Worker needs them.
  // The control token is not here: it is for `just dev` only, from .dev.vars, and the deploy
  // removes it from the Worker if an older deploy left one.
  "secrets": { "required": ["GITHUB_CLIENT_SECRET"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
